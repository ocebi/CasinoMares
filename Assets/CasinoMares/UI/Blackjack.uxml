<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <ui:VisualElement name="bj-root" class="screen hidden" picking-mode="Ignore">
        <ui:VisualElement class="bj-top" picking-mode="Ignore">
            <ui:Label name="phase-label" class="bj-phase" picking-mode="Ignore" />
            <ui:VisualElement name="timer" class="bj-timer" picking-mode="Ignore">
                <ui:VisualElement name="timer-fill" class="bj-timer-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="bj-bottom" picking-mode="Ignore">
            <ui:VisualElement name="bet-panel" class="bj-panel">
                <ui:VisualElement name="chip-row" style="flex-direction: row;" />
                <ui:Label name="bet-label" class="bj-bet" text="0" />
                <ui:Button name="clear-button" text="Clear" class="bj-button bj-button--secondary icon-only">
                    <ui:VisualElement class="btn-icon icon--clear" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="sitout-button" text="Sit out" class="bj-button bj-button--secondary icon-only">
                    <ui:VisualElement class="btn-icon icon--sitout" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="deal-button" text="Deal (Space)" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--deal" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="action-panel" class="bj-panel hidden">
                <ui:Button name="hit-button" text="Hit (H)" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--hit" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="stand-button" text="Stand (Space)" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--stand" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="double-button" text="Double (X)" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--double" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="split-button" text="Split (P)" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--split" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="status-label" class="bj-phase hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="settings-panel" class="panel bj-settings hidden">
            <ui:Label text="Table settings" class="bj-settings-title" />
            <ui:Button name="turn-timer-button" class="bj-setting" />
            <ui:Button name="bet-timer-button" class="bj-setting" />
            <ui:Button name="npc-button" class="bj-setting" />
        </ui:VisualElement>
        <ui:VisualElement class="bj-corner">
            <ui:Label name="view-caption" class="bj-view-caption" picking-mode="Ignore" />
            <ui:Button name="view-button" text="View (V)" class="bj-button bj-button--secondary icon-only">
                <ui:VisualElement class="btn-icon icon--view-overhead" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="settings-button" text="Settings" class="bj-button bj-button--secondary icon-only">
                <ui:VisualElement class="btn-icon icon--settings" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="leave-button" text="Stand up (E)" class="bj-button bj-button--secondary icon-only">
                <ui:VisualElement class="btn-icon icon--leave" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
