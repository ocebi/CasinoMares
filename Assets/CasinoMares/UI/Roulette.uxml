<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <ui:VisualElement name="rl-root" class="screen hidden" picking-mode="Ignore">
        <ui:VisualElement class="bj-top" picking-mode="Ignore">
            <ui:Label name="phase-label" class="bj-phase" picking-mode="Ignore" />
            <ui:VisualElement name="timer" class="bj-timer" picking-mode="Ignore">
                <ui:VisualElement name="timer-fill" class="bj-timer-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="history" class="rl-history" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="bj-bottom" picking-mode="Ignore">
            <ui:VisualElement name="board" class="rl-board" />
            <ui:VisualElement class="bj-panel rl-controls">
                <ui:VisualElement name="chip-row" style="flex-direction: row;" />
                <ui:Label name="total-label" class="bj-bet" text="0" />
                <ui:Button name="clear-button" text="Clear" class="bj-button bj-button--secondary icon-only">
                    <ui:VisualElement class="btn-icon icon--clear" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="done-button" text="Ready" class="bj-button icon-labelled">
                    <ui:VisualElement class="btn-icon icon--check" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="my-bets" class="panel rl-my-bets hidden" picking-mode="Ignore">
            <ui:Label text="Your bets" class="bj-settings-title" picking-mode="Ignore" />
            <ui:VisualElement name="my-bets-rows" picking-mode="Ignore" />
            <ui:Label name="my-bets-total" class="rl-my-bets-total" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="settings-panel" class="panel bj-settings hidden">
            <ui:Label text="Table settings" class="bj-settings-title" />
            <ui:Button name="bet-timer-button" class="bj-setting" />
            <ui:Button name="npc-button" class="bj-setting" />
            <ui:Button name="wheel-closeup-button" class="bj-setting" />
        </ui:VisualElement>
        <ui:VisualElement class="bj-corner">
            <ui:Button name="settings-button" text="Settings" class="bj-button bj-button--secondary icon-only">
                <ui:VisualElement class="btn-icon icon--settings" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="leave-button" text="Stand up (E)" class="bj-button bj-button--secondary icon-only">
                <ui:VisualElement class="btn-icon icon--leave" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
