<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <ui:VisualElement name="hud-root" class="screen hidden" picking-mode="Ignore">
        <ui:VisualElement class="hud-chip hud-balance" picking-mode="Ignore">
            <ui:Label text="Chips" class="hud-label-dim" />
            <ui:Label name="balance-label" text="0" class="hud-value" />
            <!-- Glasses of wine still in effect: one pip each (up to 5), "Tipsy" from the third. -->
            <ui:VisualElement name="drink-row" class="drink-row hidden" picking-mode="Ignore">
                <ui:VisualElement name="drink-pips" class="drink-pips" picking-mode="Ignore" />
                <ui:Label name="drink-label" text="Tipsy" class="drink-label hidden" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- Chips just earned (pawing, the cat wall, welfare): HudController animates it. -->
            <ui:Label name="balance-gain" text="+10" class="balance-gain hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Desktop only: phones have the same in their touch pills and Emote button. -->
        <ui:VisualElement name="desktop-pills" class="hud-pills" picking-mode="Ignore">
            <ui:Button name="settings-button" text="Settings (Esc)" class="hud-pill" />
            <ui:Button name="chat-button" text="Chat (Enter)" class="hud-pill" />
            <ui:Button name="emotes-button" text="Emotes (Q)" class="hud-pill" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-chip hud-players" picking-mode="Ignore">
            <ui:Label text="Cats online" class="hud-label-dim" />
            <ui:Label name="players-label" text="1/10" class="hud-value" />
        </ui:VisualElement>
        <ui:VisualElement name="toast-stack" class="toast-stack" picking-mode="Ignore" />
        <ui:VisualElement name="prompt" class="prompt hidden" picking-mode="Ignore">
            <ui:Label name="prompt-label" class="prompt-label" picking-mode="Ignore" enable-rich-text="true" />
        </ui:VisualElement>
        <!-- Top cats (UX §1.10): chips earned this session. The podium is fixed here; HudController fills it, adds the
             lb-row rows from 4th down, and pins the local cat's row below a gap when it's outside them. -->
        <ui:VisualElement name="leaderboard" class="panel leaderboard hidden" picking-mode="Ignore">
            <ui:VisualElement class="lb-header" picking-mode="Ignore">
                <ui:Label text="Top cats" class="leaderboard-title" />
                <ui:Label text="this session" class="lb-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement name="lb-podium" class="lb-podium" picking-mode="Ignore">
                <ui:VisualElement name="lb-podium-2" class="lb-podium-card lb-podium-2" picking-mode="Ignore">
                    <ui:Label text="2" class="lb-podium-place" picking-mode="Ignore" />
                    <ui:VisualElement class="lb-podium-swatch" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-name" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-net" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lb-podium-1" class="lb-podium-card lb-podium-1" picking-mode="Ignore">
                    <ui:VisualElement class="lb-podium-crown icon--crown" picking-mode="Ignore" />
                    <ui:VisualElement class="lb-podium-swatch" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-name" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-net" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lb-podium-3" class="lb-podium-card lb-podium-3" picking-mode="Ignore">
                    <ui:Label text="3" class="lb-podium-place" picking-mode="Ignore" />
                    <ui:VisualElement class="lb-podium-swatch" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-name" picking-mode="Ignore" />
                    <ui:Label class="lb-podium-net" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="leaderboard-rows" class="lb-rows" picking-mode="Ignore" />
            <ui:Label name="lb-gap" text="···" class="lb-gap hidden" picking-mode="Ignore" />
            <ui:VisualElement name="lb-you-pinned" class="lb-you-pinned hidden" picking-mode="Ignore" />
            <ui:VisualElement name="lb-empty" class="lb-empty hidden" picking-mode="Ignore">
                <ui:Label text="Earn your first chips" class="lb-empty-title" picking-mode="Ignore" />
                <ui:Label text="Win a hand, paw a patron or top the cat wall." class="lb-empty-sub" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="hint-label" text="WASD move · Shift run · Space jump · Click paw swipe · Q emotes · E interact · Enter chat · Tab leaderboard · Esc menu" class="hud-hint" picking-mode="Ignore" />
        <ui:VisualElement name="pause-root" class="screen pause-backdrop hidden">
            <ui:VisualElement class="panel pause-panel">
                <ui:Label text="Paused" class="pause-title" />
                <ui:Slider name="volume-slider" label="Volume" low-value="0" high-value="1" />
                <ui:Slider name="sensitivity-slider" label="Mouse sensitivity" low-value="0.02" high-value="0.4" />
                <ui:Slider name="distance-slider" label="Camera distance" low-value="1" high-value="3.5" />
                <ui:Toggle name="follow-toggle" label="Camera turns with the cat" class="pause-toggle" />
                <ui:Toggle name="tipsy-toggle" label="Tipsy visuals" class="pause-toggle" />
                <ui:Toggle name="fps-toggle" label="Hold the frame rate at 30 (cooler phone)" class="pause-toggle hidden" />
                <ui:Button name="resume-button" text="Resume" class="primary-button" />
                <ui:Button name="fullscreen-button" text="Full screen" class="secondary-button" />
                <ui:Label name="home-screen-hint" text="For full screen on iPhone: tap Share, then Add to Home Screen, and open the game from there." class="hint pause-hint hidden" />
                <ui:Button name="leave-button" text="Leave casino" class="secondary-button" />
                <ui:Button name="quit-button" text="Quit game" class="secondary-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
