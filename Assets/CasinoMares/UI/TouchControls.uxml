<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Common.uss" />
    <!-- The root is the look/move surface: it only gets touches that nothing above it wants. -->
    <ui:VisualElement name="touch-root" class="screen hidden">
        <ui:VisualElement name="stick" class="touch-stick" picking-mode="Ignore">
            <ui:VisualElement name="stick-ring" class="touch-stick-ring" picking-mode="Ignore" />
            <ui:VisualElement name="stick-knob" class="touch-stick-knob" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="walk-buttons" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="jump-button" class="touch-button touch-button--jump">
                <ui:VisualElement class="touch-button-icon icon--jump" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="paw-button" class="touch-button touch-button--paw">
                <ui:VisualElement class="touch-button-icon icon--paw" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="emote-button" class="touch-button touch-button--emote">
                <ui:VisualElement class="touch-button-icon icon--emote" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="touch-pills" picking-mode="Ignore">
            <ui:Button name="menu-button" text="Menu" class="touch-pill icon-only">
                <ui:VisualElement class="btn-icon icon--menu" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="chat-button" text="Chat" class="touch-pill icon-only">
                <ui:VisualElement class="btn-icon icon--chat" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="leaders-button" text="Top cats" class="touch-pill icon-only">
                <ui:VisualElement class="btn-icon icon--leaders" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
