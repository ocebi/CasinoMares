/* Casino Mares shared UI theme: warm lounge colors on built-in UI Toolkit controls. */
:root {
    --cm-bg: rgba(28, 18, 24, 0.92);
    --cm-bg-soft: rgba(28, 18, 24, 0.7);
    --cm-border: rgb(120, 84, 52);
    --cm-gold: rgb(232, 186, 98);
    --cm-gold-dark: rgb(176, 130, 58);
    --cm-text: rgb(245, 236, 222);
    --cm-text-dim: rgb(190, 176, 160);
    --cm-danger: rgb(222, 104, 96);
    --cm-wine: rgb(140, 28, 56);
    /* Wine red that reads as text on the dark panels (losses on the leaderboard). */
    --cm-wine-text: rgb(222, 96, 124);
    -unity-font-style: normal;
    color: var(--cm-text);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.panel {
    background-color: var(--cm-bg);
    border-color: var(--cm-border);
    border-width: 2px;
    border-radius: 14px;
    padding: 24px 28px;
}

.hidden {
    display: none;
}

/* Main menu */
.menu-backdrop {
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 6, 10, 0.35);
}

.menu-panel {
    width: 460px;
}

.title {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 16px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.field-label {
    font-size: 15px;
    color: var(--cm-text-dim);
    margin: 14px 3px 6px 3px;
}

.hint {
    font-size: 13px;
    color: var(--cm-text-dim);
    margin: 4px 3px 0 3px;
}

.swatch-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.swatch {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    margin: 0 8px 0 3px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.swatch--selected {
    border-color: var(--cm-gold);
}

.status {
    font-size: 14px;
    min-height: 20px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-center;
    margin-top: 10px;
    white-space: normal;
}

.status--error {
    color: var(--cm-danger);
}

/* Buttons */
.primary-button {
    height: 46px;
    margin-top: 22px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(40, 24, 12);
    background-color: var(--cm-gold);
    border-color: var(--cm-gold-dark);
    border-radius: 10px;
}

.primary-button:hover {
    background-color: rgb(245, 204, 124);
}

.primary-button:disabled {
    opacity: 0.5;
}

.secondary-button {
    height: 34px;
    margin-top: 10px;
    font-size: 15px;
    color: var(--cm-text);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--cm-border);
    border-radius: 8px;
}

.secondary-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

/* Text fields */
.unity-text-field > .unity-label {
    color: var(--cm-text-dim);
    min-width: 60px;
}

.unity-base-text-field__input {
    font-size: 17px;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: rgb(52, 38, 44);
    border-color: var(--cm-border);
    color: var(--cm-text);
}

/* HUD */
.hud-chip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: var(--cm-bg-soft);
    border-color: var(--cm-border);
    border-width: 1px;
    border-radius: 10px;
    padding: 8px 14px;
}

.hud-balance {
    left: 20px;
    top: 20px;
}

/* Chips just earned, beside the balance; HudController pops it up, then lets it rise and fade. */
.balance-gain {
    position: absolute;
    left: 100%;
    top: 8px;
    margin-left: 8px;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(60, 30, 8);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
}

.balance-gain--big {
    top: 2px;
    font-size: 30px;
}

/* Glasses of wine beside the balance (UX §1.1): a pip per glass, "Tipsy" from the third. */
.drink-row {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    padding-left: 10px;
    border-left-width: 1px;
    border-color: rgba(120, 84, 52, 0.8);
}

.drink-pips {
    flex-direction: row;
    align-items: center;
}

.drink-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-left: 4px;
    background-color: var(--cm-wine);
    border-width: 1px;
    border-color: rgba(232, 186, 98, 0.7);
}

.drink-label {
    margin-left: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

.hud-players {
    right: 20px;
    top: 20px;
}

.hud-label-dim {
    font-size: 14px;
    color: var(--cm-text-dim);
    margin-right: 8px;
}

.hud-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

/* The cat wall's clock (CatWallHud), top middle between the chips. */
.climb-row {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    align-items: center;
}

.climb {
    flex-direction: row;
    align-items: center;
    background-color: var(--cm-bg-soft);
    border-color: var(--cm-border);
    border-width: 1px;
    border-radius: 10px;
    padding: 8px 14px;
}

.climb--done {
    border-color: var(--cm-gold);
}

.climb-time {
    min-width: 64px;
}

.climb-best {
    font-size: 14px;
    color: var(--cm-text-dim);
    margin-left: 10px;
}

.hud-hint {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 13px;
    color: rgba(245, 236, 222, 0.55);
}

/* While seated the table UI owns the bottom centre, so the hint moves to the bottom-left corner. */
.hud-hint--seated {
    left: 24px;
    right: auto;
    bottom: 30px;
    -unity-text-align: middle-left;
}

.pause-toggle {
    margin: 6px 0 10px 0;
}

.pause-hint {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.pause-backdrop {
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 6, 10, 0.55);
}

.pause-panel {
    width: 380px;
}

.pause-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

/* Nameplates */
.nameplate {
    position: absolute;
    translate: -50% -100%;
    padding: 3px 10px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cm-text);
    background-color: rgba(20, 12, 16, 0.6);
    border-radius: 8px;
    border-bottom-width: 3px;
    white-space: nowrap;
}

/* The leading cat (UX §1.10): gold name and outline (the swatch stays on the bottom edge) and a crown above. */
.nameplate--leader {
    color: var(--cm-gold);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--cm-gold);
}

.nameplate-crown {
    position: absolute;
    left: 50%;
    top: -26px;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    background-image: url("Icons/crown.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--cm-gold);
}

/* Interaction prompt & toasts */
.prompt {
    position: absolute;
    bottom: 64px;
    left: 0;
    right: 0;
    align-items: center;
}

.prompt-label {
    font-size: 18px;
    padding: 8px 16px;
    border-radius: 10px;
    background-color: var(--cm-bg-soft);
    border-color: var(--cm-border);
    border-width: 1px;
    color: var(--cm-text);
}

.prompt-label--disabled {
    color: var(--cm-text-dim);
    opacity: 0.8;
}

.key {
    color: var(--cm-gold);
    -unity-font-style: bold;
}

.toast-stack {
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast {
    font-size: 17px;
    padding: 8px 18px;
    margin-bottom: 6px;
    border-radius: 10px;
    background-color: rgba(60, 40, 20, 0.9);
    border-color: var(--cm-gold-dark);
    border-width: 1px;
    color: var(--cm-text);
}

/* Top cats (UX §1.10): chips earned this session, a podium for the top three, then rows; the local cat's row is
   highlighted and pinned at the bottom when it's outside the list. The leader-* rules below are the old rows; they can
   go once HudController and LeaderboardBoard build lb-row. */
.leaderboard {
    position: absolute;
    top: 90px;
    right: 20px;
    width: 360px;
    padding: 16px 18px;
}

.lb-header {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 10px;
}

.leaderboard-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    margin-bottom: 8px;
}

.lb-header > .leaderboard-title {
    margin-bottom: 0;
}

.lb-subtitle {
    margin: 0 0 3px 8px;
    font-size: 14px;
    color: var(--cm-text-dim);
}

.lb-podium {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.lb-podium-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 104px;
    margin: 0 3px;
    padding: 6px 6px 8px 6px;
    align-items: center;
    justify-content: flex-end;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--cm-border);
    background-color: rgba(255, 255, 255, 0.05);
}

.lb-podium-1 {
    height: 124px;
    border-width: 2px;
    border-color: var(--cm-gold);
    background-color: rgba(232, 186, 98, 0.12);
}

.lb-podium--empty {
    opacity: 0.35;
}

.lb-podium-place {
    margin-bottom: 2px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--cm-text-dim);
}

.lb-podium-crown {
    width: 26px;
    height: 26px;
    margin-bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--cm-gold);
}

.lb-podium-swatch {
    width: 28px;
    height: 28px;
    margin-bottom: 4px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.1);
}

.lb-podium-name {
    max-width: 100%;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lb-podium-net {
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--cm-text-dim);
}

.lb-podium-1 > .lb-podium-name {
    font-size: 15px;
}

.lb-podium-1 > .lb-podium-net {
    font-size: 17px;
}

.lb-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin-top: 2px;
    padding: 0 8px;
    border-radius: 8px;
}

.lb-rank {
    width: 24px;
    margin-right: 4px;
    padding: 0;
    font-size: 15px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-right;
}

/* Shown for a few seconds after the cat's rank changes (C# adds and removes the class). */
.lb-move {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    opacity: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.lb-move--up {
    opacity: 1;
    background-image: url("Icons/jump.png");
    -unity-background-image-tint-color: var(--cm-gold);
}

.lb-move--down {
    opacity: 1;
    background-image: url("Icons/view-overhead.png");
    -unity-background-image-tint-color: var(--cm-wine-text);
}

.lb-swatch {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    border-radius: 7px;
}

.lb-name {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0;
    font-size: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lb-net {
    margin-left: 8px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--cm-text-dim);
}

/* Signed net: gold for a gain, wine red for a loss, dim at zero (podium and rows alike). */
.lb-net--pos {
    color: var(--cm-gold);
}

.lb-net--neg {
    color: var(--cm-wine-text);
}

.lb-row--you {
    padding-left: 5px;
    border-left-width: 3px;
    border-color: var(--cm-gold);
    background-color: rgba(232, 186, 98, 0.12);
}

.lb-gap {
    height: 16px;
    padding: 0;
    font-size: 16px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-center;
}

.lb-empty {
    align-items: center;
    padding: 18px 0 8px 0;
}

.lb-empty-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

.lb-empty-sub {
    margin-top: 4px;
    font-size: 14px;
    color: var(--cm-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Phones (landscape, ~560 px tall): podium, three rows and the pinned row fit under the pills. */
.touch .leaderboard {
    top: 140px;
    width: 340px;
    max-height: 300px;
    padding: 12px 14px;
    overflow: hidden;
}

.touch .lb-header {
    margin-bottom: 6px;
}

.touch .lb-podium-card {
    height: 88px;
    padding-bottom: 6px;
}

.touch .lb-podium-1 {
    height: 100px;
}

.touch .lb-podium-place,
.touch .lb-podium-crown {
    margin-bottom: 0;
}

.touch .lb-podium-swatch {
    width: 22px;
    height: 22px;
    border-radius: 11px;
}

.touch .lb-row {
    height: 30px;
}

.leader-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.leader-rank {
    width: 28px;
    color: var(--cm-text-dim);
    font-size: 15px;
}

.leader-swatch {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 8px;
}

.leader-name {
    flex-grow: 1;
    font-size: 16px;
}

.leader-balance {
    font-size: 16px;
    color: var(--cm-gold);
    -unity-font-style: bold;
}

/* Chat */
.chat {
    position: absolute;
    left: 20px;
    bottom: 60px;
    width: 460px;
}

.chat-log {
    max-height: 260px;
}

.chat-line {
    font-size: 15px;
    white-space: normal;
    padding: 2px 8px;
    background-color: rgba(20, 12, 16, 0.45);
    margin-bottom: 1px;
}

.chat-line--system {
    color: rgb(230, 200, 140);
    -unity-font-style: italic;
}

.chat-input {
    margin-top: 6px;
}

/* Blackjack seat UI */
.bj-top {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    align-items: center;
}

.bj-phase {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    padding: 6px 18px;
    border-radius: 10px;
    background-color: var(--cm-bg-soft);
}

.bj-timer {
    width: 300px;
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.12);
}

.bj-timer-fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--cm-gold);
}

.bj-bottom {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    align-items: center;
}

.bj-panel {
    flex-direction: row;
    align-items: center;
    background-color: var(--cm-bg);
    border-color: var(--cm-border);
    border-width: 2px;
    border-radius: 14px;
    padding: 12px 16px;
}

.bj-chip {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    margin: 0 5px;
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.75);
    color: rgb(255, 255, 255);
}

.bj-bet {
    font-size: 22px;
    min-width: 120px;
    -unity-text-align: middle-center;
    color: var(--cm-gold);
    -unity-font-style: bold;
}

.bj-button {
    height: 46px;
    min-width: 96px;
    margin: 0 5px;
    font-size: 17px;
    -unity-font-style: bold;
    border-radius: 10px;
    color: rgb(40, 24, 12);
    background-color: var(--cm-gold);
    border-color: var(--cm-gold-dark);
}

.bj-button:hover {
    background-color: rgb(245, 204, 124);
}

.bj-button:disabled {
    opacity: 0.35;
}

.bj-button--secondary {
    color: var(--cm-text);
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--cm-border);
}

.bj-button--secondary:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

/* The bar's Order button while busy (UX §1.5): it carries a countdown, so it stays readable when disabled. */
.bj-button--wait {
    color: var(--cm-text-dim);
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--cm-border);
}

.bj-button--wait:disabled {
    opacity: 0.9;
}

/* The bar's tipsy meter: a segment per glass still in effect, the tipsy ones brighter, full at the full effect. */
.bar-meter {
    min-width: 128px;
    margin-right: 10px;
    justify-content: center;
}

.bar-count {
    margin-bottom: 5px;
    padding: 0;
    font-size: 16px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-left;
}

.bar-count--tipsy {
    color: var(--cm-gold);
    -unity-font-style: bold;
}

.bar-meter-track {
    flex-direction: row;
    padding: 2px 2px 2px 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(120, 84, 52, 0.8);
    background-color: rgba(0, 0, 0, 0.25);
    transition-property: border-color;
    transition-duration: 0.4s;
}

.bar-meter-seg {
    width: 22px;
    height: 10px;
    margin-left: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.1);
    transition-property: background-color;
    transition-duration: 0.4s;
}

/* A gap before the third glass: where tipsy starts. */
.bar-meter-seg--tipsy-start {
    margin-left: 6px;
}

.bar-meter-seg--full {
    background-color: var(--cm-wine);
}

.bar-meter-seg--tipsy.bar-meter-seg--full {
    background-color: rgb(196, 52, 88);
}

.bar-meter--full {
    border-color: var(--cm-gold);
}

.bj-corner {
    position: absolute;
    right: 20px;
    bottom: 20px;
    flex-direction: row;
}

/* The table view's name, shown for a moment beside the View button when it changes (UX §1.4). */
.bj-view-caption {
    align-self: center;
    margin-right: 6px;
    padding: 4px 10px;
    font-size: 15px;
    color: var(--cm-text-dim);
    border-radius: 8px;
    background-color: var(--cm-bg-soft);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.bj-view-caption--show {
    opacity: 1;
}

.bj-settings {
    position: absolute;
    right: 20px;
    bottom: 90px;
    width: 300px;
}

.bj-settings-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    margin-bottom: 8px;
}

.bj-setting {
    height: 36px;
    margin: 3px 0;
    font-size: 15px;
    color: var(--cm-text);
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--cm-border);
    border-radius: 8px;
}

/* World labels over hands */
.hand-label {
    position: absolute;
    translate: -50% -100%;
    padding: 2px 8px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 7px;
    background-color: rgba(20, 12, 16, 0.72);
    color: var(--cm-text);
    white-space: nowrap;
}

.hand-label--active {
    border-color: var(--cm-gold);
    border-width: 2px;
}

.hand-label--win {
    background-color: rgba(40, 120, 60, 0.85);
}

.hand-label--lose {
    background-color: rgba(140, 40, 40, 0.85);
}

.hand-label--push {
    background-color: rgba(90, 90, 110, 0.85);
}

/* The drunk player's own hand: "17 or 21?" (UX §1.2). */
.hand-label--tipsy {
    background-color: rgba(90, 24, 48, 0.82);
    -unity-font-style: bold-and-italic;
}

/* Spectator panel */
.spectator {
    position: absolute;
    right: 20px;
    top: 140px;
    width: 330px;
}

.spectator-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

.spectator-body {
    font-size: 15px;
    white-space: normal;
    margin-top: 6px;
}

/* Gift dialog */
.dialog-backdrop {
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 6, 10, 0.5);
}

.dialog {
    width: 420px;
}

.dialog-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    margin-bottom: 12px;
}

.dialog-row {
    flex-direction: row;
    margin-top: 10px;
}

.dialog-row > Button {
    flex-grow: 1;
}

/* Wall leaderboard (rendered into a texture) */
.board {
    background-color: rgb(34, 20, 26);
    border-color: var(--cm-gold);
    border-width: 8px;
    padding: 24px 40px;
}

.board-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.board .leader-row {
    padding: 6px 0;
}

.board .leader-rank {
    width: 60px;
    font-size: 30px;
}

.board .leader-swatch {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-right: 16px;
}

.board .leader-name,
.board .leader-balance {
    font-size: 32px;
}

.board .lb-row {
    height: 56px;
    margin-top: 4px;
    padding: 0 12px;
}

.board .lb-rank {
    width: 56px;
    margin-right: 8px;
    font-size: 30px;
}

.board .lb-move {
    width: 26px;
    height: 26px;
    margin-right: 12px;
}

.board .lb-swatch {
    width: 26px;
    height: 26px;
    margin-right: 16px;
    border-radius: 13px;
}

.board .lb-name,
.board .lb-net {
    font-size: 32px;
}

.board-empty {
    font-size: 28px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-center;
    margin-top: 40px;
}

/* Roulette board */
.rl-board {
    flex-direction: column;
    background-color: rgba(10, 60, 36, 0.92);
    border-color: var(--cm-gold-dark);
    border-width: 2px;
    border-radius: 10px;
    padding: 8px;
    margin-bottom: 8px;
}

.rl-row {
    flex-direction: row;
}

.rl-cell {
    width: 46px;
    height: 40px;
    margin: 1px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 3px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.rl-cell:hover {
    border-color: var(--cm-gold);
    border-width: 2px;
}

.rl-cell--red {
    background-color: rgb(170, 30, 38);
}

.rl-cell--black {
    background-color: rgb(28, 26, 30);
}

.rl-cell--green {
    background-color: rgb(20, 120, 60);
}

.rl-cell--winner {
    border-color: rgb(255, 230, 120);
    border-width: 3px;
}

.rl-chip-badge {
    position: absolute;
    right: 1px;
    bottom: 1px;
    font-size: 11px;
    padding: 0 3px;
    border-radius: 6px;
    background-color: var(--cm-gold);
    color: rgb(40, 24, 12);
}

.rl-dots {
    position: absolute;
    top: 2px;
    left: 0;
    right: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.rl-dot {
    width: 9px;
    height: 9px;
    margin: 0 1px 1px 1px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.65);
}

.rl-players {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 4px;
}

.rl-player {
    flex-direction: row;
    align-items: center;
    margin: 0 8px 2px 8px;
}

.rl-player-swatch {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    margin-right: 5px;
}

.rl-player-name {
    font-size: 13px;
    color: var(--cm-text);
    padding: 0;
}

.rl-spot-info {
    font-size: 12px;
    color: var(--cm-text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    padding: 0;
}

.rl-controls {
    align-self: center;
}

.rl-history {
    flex-direction: row;
    margin-top: 8px;
}

.rl-history-item {
    width: 30px;
    height: 30px;
    margin: 0 2px;
    border-radius: 15px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.slots-paytable {
    position: absolute;
    left: 20px;
    top: 90px;
    width: 260px;
}

/* Slots: the BIG WIN banner, whose payout counts up */
.slots-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 26%;
    align-items: center;
    opacity: 0;
    scale: 0.5 0.5;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.slots-banner--show {
    opacity: 1;
    scale: 1 1;
}

.slots-banner-title {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(90, 40, 10);
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.7);
}

.slots-banner--top .slots-banner-title {
    color: rgb(255, 150, 210);
    -unity-text-outline-color: rgb(90, 20, 60);
}

.slots-banner-amount {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--cm-text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 20, 10);
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.7);
}

/* Roulette: your own bets, on a card at the side while the camera watches the wheel */
.rl-my-bets {
    position: absolute;
    right: 20px;
    top: 28%;
    width: 250px;
    padding: 14px 18px;
}

.rl-my-bet {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.rl-my-bet-spot {
    min-width: 44px;
    padding: 1px 8px;
    border-radius: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
}

.rl-my-bet-amount {
    flex-grow: 1;
    padding: 0 0 0 10px;
    font-size: 15px;
    -unity-text-align: middle-right;
    color: var(--cm-text);
}

.rl-my-bet--won .rl-my-bet-amount {
    -unity-font-style: bold;
    color: rgb(140, 230, 140);
}

.rl-my-bet--lost {
    opacity: 0.45;
}

.rl-my-bets-more {
    font-size: 13px;
    color: var(--cm-text-dim);
    padding: 2px 0 0 0;
}

.rl-my-bets-total {
    margin-top: 8px;
    padding: 6px 0 0 0;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

/* Baccarat */
.bc-spots {
    flex-direction: row;
    margin-bottom: 8px;
}

.bc-spot {
    width: 170px;
    height: 84px;
    margin: 0 6px;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 12px;
}

.bc-spot--player {
    background-color: rgb(40, 80, 170);
}

.bc-spot--banker {
    background-color: rgb(160, 30, 40);
}

.bc-spot--tie {
    background-color: rgb(20, 110, 60);
}

/* Poker */
.pk-hand {
    position: absolute;
    left: 24px;
    bottom: 110px;
    align-items: center;
}

.pk-best {
    margin-top: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    padding: 4px 12px;
    border-radius: 8px;
    background-color: var(--cm-bg-soft);
}

.pk-info {
    font-size: 17px;
    color: var(--cm-text);
    padding: 4px 14px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: var(--cm-bg-soft);
}

.pk-raise {
    flex-direction: row;
    align-items: center;
}

.pk-small {
    min-width: 44px;
    padding: 0 8px;
}

.pk-allin {
    background-color: rgb(210, 90, 70);
    border-color: rgb(150, 50, 40);
    color: rgb(255, 245, 235);
}

/* Emote wheel (hold Q) */
.emote-root {
    align-items: center;
    justify-content: center;
}

.emote-wheel {
    width: 480px;
    height: 480px;
    border-radius: 240px;
    background-color: rgba(24, 14, 18, 0.72);
    border-width: 2px;
    border-color: rgba(232, 186, 98, 0.5);
}

.emote-options {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.emote-option {
    position: absolute;
    width: 132px;
    height: 58px;
    margin-left: -66px;
    margin-top: -29px;
    border-radius: 29px;
    background-color: rgba(62, 36, 40, 0.92);
    border-width: 2px;
    border-color: rgba(232, 186, 98, 0.35);
    align-items: center;
    justify-content: center;
    transition-duration: 0.08s;
    transition-property: scale, background-color;
}

.emote-option--selected {
    background-color: var(--cm-gold);
    border-color: rgb(255, 228, 160);
    scale: 1.1 1.1;
}

.emote-option-label {
    color: var(--cm-text);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.emote-option--selected .emote-option-label {
    color: rgb(42, 24, 20);
}

.emote-center {
    position: absolute;
    left: 150px;
    top: 190px;
    width: 180px;
    height: 100px;
    align-items: center;
    justify-content: center;
}

.emote-center-title {
    font-size: 22px;
    color: var(--cm-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.emote-center-hint {
    font-size: 13px;
    color: var(--cm-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.emote-pointer {
    position: absolute;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 7px;
    background-color: rgb(255, 228, 160);
}

/* Teaching mode: coach card and rules overlay (poker, baccarat) */
.coach {
    position: absolute;
    right: 20px;
    top: 84px;
    width: 390px;
    padding: 14px 18px;
}

.coach-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cm-gold);
    white-space: normal;
}

.coach-body {
    margin-top: 6px;
    font-size: 15px;
    white-space: normal;
    color: var(--cm-text);
}

.coach-meter {
    margin-top: 10px;
    height: 22px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.coach-meter-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(98, 176, 110, 0.75);
}

.coach-meter-label {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    height: 100%;
    color: rgb(255, 255, 255);
}

.coach-tip {
    margin-top: 10px;
    padding: 8px 10px;
    font-size: 16px;
    white-space: normal;
    color: rgb(40, 24, 12);
    background-color: var(--cm-gold);
    border-radius: 8px;
}

.rules-backdrop {
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 6, 10, 0.6);
}

.rules-panel {
    width: 820px;
    max-height: 86%;
    padding: 20px 26px;
}

.rules-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.rules-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

.rules-scroll {
    flex-shrink: 1;
}

.rules-heading {
    margin-top: 14px;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--cm-gold);
}

.rules-body {
    margin-top: 4px;
    font-size: 16px;
    white-space: normal;
    color: var(--cm-text);
}

/* The coach's suggestion, highlighted on the matching button */
.coach-suggested {
    border-width: 3px;
    border-color: rgb(120, 230, 140);
}

/* Touch controls (phones and tablets) */
.touch-stick {
    position: absolute;
    left: 70px;
    bottom: 70px;
    width: 192px;
    height: 192px;
    border-radius: 96px;
    border-width: 3px;
    border-color: rgba(245, 236, 222, 0.35);
    background-color: rgba(20, 12, 16, 0.25);
    align-items: center;
    justify-content: center;
    opacity: 0.6;
}

.touch-stick--active {
    translate: -50% -50%;
    opacity: 1;
}

/* The run ring at 90% of the radius (UX §1.7): faint gold while walking, solid gold (and a tinted pad) past it. */
.touch-stick-ring {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 172px;
    height: 172px;
    border-radius: 86px;
    border-width: 2px;
    border-color: rgba(232, 186, 98, 0.3);
}

.touch-stick--run {
    background-color: rgba(232, 186, 98, 0.12);
}

.touch-stick--run .touch-stick-ring {
    border-width: 3px;
    border-color: rgba(232, 186, 98, 0.9);
}

.touch-stick-knob {
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: rgba(245, 236, 222, 0.75);
    border-width: 2px;
    border-color: rgba(20, 12, 16, 0.5);
}

.touch-stick-knob--run {
    background-color: var(--cm-gold);
}

.touch-button {
    position: absolute;
    width: 92px;
    height: 92px;
    border-radius: 46px;
    border-width: 3px;
    border-color: rgba(232, 186, 98, 0.8);
    background-color: rgba(28, 18, 24, 0.6);
    align-items: center;
    justify-content: center;
}

.touch-button--pressed {
    background-color: rgba(232, 186, 98, 0.55);
    scale: 0.94 0.94;
}

.touch-button--jump {
    right: 40px;
    bottom: 40px;
    width: 124px;
    height: 124px;
    border-radius: 62px;
}

.touch-button--paw {
    right: 186px;
    bottom: 34px;
}

.touch-button--emote {
    right: 52px;
    bottom: 186px;
}

.touch-button-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--cm-text);
}

.touch-button--jump .touch-button-icon {
    width: 56px;
    height: 56px;
}

.touch-pills, .hud-pills {
    position: absolute;
    left: 20px;
    top: 82px;
    flex-direction: row;
}

.touch-pill, .hud-pill {
    height: 46px;
    min-width: 76px;
    margin: 0 8px 0 0;
    padding: 0 16px;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cm-text);
    background-color: var(--cm-bg-soft);
    border-color: var(--cm-border);
    border-width: 1px;
    border-radius: 23px;
}

/* The desktop pills are smaller: there's a mouse pointer to aim with. */
.hud-pill {
    height: 36px;
    min-width: 0;
    padding: 0 14px;
    font-size: 15px;
    border-radius: 18px;
}

.hud-pill:hover {
    border-color: var(--cm-gold);
}

.touch-pill--active {
    color: rgb(40, 24, 12);
    background-color: var(--cm-gold);
    border-color: var(--cm-gold-dark);
}

/* Tap the interaction prompt to use it. */
.prompt-label--touch {
    font-size: 22px;
    padding: 12px 26px;
    border-color: var(--cm-gold);
    border-width: 2px;
    border-radius: 26px;
}

/* Chat with touch controls: at the top, clear of the on-screen keyboard, newest input first. */
.chat-input-row {
    flex-direction: row;
    margin-top: 6px;
}

.chat-input-row > .chat-input {
    flex-grow: 1;
    margin: 0;
}

.chat-send {
    margin: 0 0 0 6px;
    padding: 0 18px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(40, 24, 12);
    background-color: var(--cm-gold);
    border-color: var(--cm-gold-dark);
    border-radius: 8px;
}

.chat--touch {
    top: 140px;
    bottom: auto;
    width: 330px;
    flex-direction: column-reverse;
}

.chat--touch .chat-input-row {
    margin: 0 0 6px 0;
}

.chat--touch .chat-log {
    max-height: 200px;
}

/* Touch layout: every document root gets .touch. The table corner (settings, stand up) moves to the top right, where
   the bottom panel can't run into it on a narrow screen. */
.touch .bj-corner {
    top: 82px;
    bottom: auto;
}

.touch .bj-settings {
    top: 146px;
    bottom: auto;
}

.touch .hud-hint--seated {
    display: none;
}

/* Toasts go below the top row (pills, phase banner, corner buttons) and stay clear of the chat on the left. */
.touch .toast-stack {
    top: 150px;
}

.touch .toast {
    max-width: 520px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.touch .slots-paytable {
    top: 146px;
}

.touch .slots-banner {
    top: 20%;
}

.touch .slots-banner-title {
    font-size: 52px;
}

.touch .slots-banner-amount {
    font-size: 32px;
}

.touch .rl-my-bets {
    top: 146px;
    width: 200px;
    padding: 10px 12px;
}

.touch .rl-my-bet-spot,
.touch .rl-my-bet-amount,
.touch .rl-my-bets-total {
    font-size: 13px;
}

/* Touch icons (UX §1.9). On touch a button shows its glyph from Icons/ (white, tinted here to the button's text
   colour); desktop keeps the words and key hints. "icon-only" buttons hide their text; "icon-labelled" ones (money
   and in-hand decisions, where a wrong tap costs chips) keep a short label under the glyph. */
.btn-icon {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    margin-top: -13px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(40, 24, 12);
}

.touch .btn-icon {
    display: flex;
}

.bj-button--secondary > .btn-icon,
.bj-button--wait > .btn-icon,
.touch-pill > .btn-icon {
    -unity-background-image-tint-color: var(--cm-text);
}

.pk-allin > .btn-icon {
    -unity-background-image-tint-color: rgb(255, 245, 235);
}

.touch-pill--active > .btn-icon {
    -unity-background-image-tint-color: rgb(40, 24, 12);
}

.touch .icon-only {
    width: 52px;
    min-width: 52px;
    padding: 0;
    overflow: hidden;
    color: rgba(0, 0, 0, 0);
}

.touch .icon-labelled {
    height: 60px;
    min-width: 64px;
    padding: 0 8px 5px 8px;
    font-size: 13px;
    -unity-text-align: lower-center;
}

.touch .icon-labelled > .btn-icon {
    top: 7px;
    margin-top: 0;
}

.icon--allin { background-image: url("Icons/allin.png"); }
.icon--call { background-image: url("Icons/call.png"); }
.icon--chat { background-image: url("Icons/chat.png"); }
.icon--check { background-image: url("Icons/check.png"); }
.icon--clear { background-image: url("Icons/clear.png"); }
.icon--crown { background-image: url("Icons/crown.png"); }
.icon--deal { background-image: url("Icons/deal.png"); }
.icon--double { background-image: url("Icons/double.png"); }
.icon--emote { background-image: url("Icons/emote.png"); }
.icon--fold { background-image: url("Icons/fold.png"); }
.icon--hit { background-image: url("Icons/hit.png"); }
.icon--jump { background-image: url("Icons/jump.png"); }
.icon--leaders { background-image: url("Icons/leaders.png"); }
.icon--leave { background-image: url("Icons/leave.png"); }
.icon--menu { background-image: url("Icons/menu.png"); }
.icon--paw { background-image: url("Icons/paw.png"); }
.icon--raise { background-image: url("Icons/raise.png"); }
.icon--rebuy { background-image: url("Icons/rebuy.png"); }
.icon--rules { background-image: url("Icons/rules.png"); }
.icon--send { background-image: url("Icons/send.png"); }
.icon--settings { background-image: url("Icons/settings.png"); }
.icon--sitout { background-image: url("Icons/sitout.png"); }
.icon--spin { background-image: url("Icons/spin.png"); }
.icon--split { background-image: url("Icons/split.png"); }
.icon--stand { background-image: url("Icons/stand.png"); }
.icon--view-overhead { background-image: url("Icons/view-overhead.png"); }
.icon--view-seat { background-image: url("Icons/view-seat.png"); }
.icon--view-wide { background-image: url("Icons/view-wide.png"); }
.icon--wine { background-image: url("Icons/wine.png"); }
